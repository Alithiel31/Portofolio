# ── Backend ───────────────────────────────────────────────────────────────────
# Copier ce fichier en .env dans le dossier backend/ :
#   cp backend/.env.example backend/.env
#
# Ce fichier est lu à la fois par le service `backend` et par le service `postgres`
# (docker-compose.yml → env_file). Tel quel, `docker compose up --build` doit fonctionner
# sur un clone frais, sans édition manuelle.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Consommé par l'image postgres:16-alpine à la création du volume, et par son healthcheck.
POSTGRES_USER="portfolio"
POSTGRES_PASSWORD="portfolio"
POSTGRES_DB="portfolio"

# Doit rester cohérent avec les trois variables ci-dessus.
# `postgres` = nom du service dans docker-compose.yml.
DATABASE_URL="postgresql://portfolio:portfolio@postgres:5432/portfolio?schema=public"

# Hors Docker (backend lancé en local, postgres exposé sur l'hôte) :
# DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"

# ── Serveur ───────────────────────────────────────────────────────────────────
NODE_ENV="development"

# 3001 : valeur attendue par le proxy nginx (frontend/nginx.conf) et par le proxy Vite.
# Ne pas changer sans mettre à jour ces deux fichiers.
PORT=3001

# URL du frontend en prod, pour le CORS. Non utilisé en développement.
# FRONTEND_URL="https://votre-domaine.dev"

# ── Formulaire de contact ─────────────────────────────────────────────────────
# Clé API Resend (https://resend.com). Sans elle, POST /api/contact répond 503 ;
# le reste du portfolio fonctionne normalement.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Email de destination des messages du formulaire.
CONTACT_EMAIL="votre@email.com"

# ── Statistiques de visite ────────────────────────────────────────────────────
# Secret requis pour lire GET /api/stats (en-tête `X-Stats-Token`). Sans cette variable,
# la route répond 404 — elle ne s'ouvre jamais par défaut.
#   Générer : openssl rand -base64 32
# STATS_TOKEN=""

# Sel du hachage des clés du rate limiter. Les IP ne sont jamais stockées en clair, même
# en mémoire. À défaut, un sel aléatoire est tiré au démarrage (les compteurs repartent
# alors de zéro à chaque redémarrage).
#   Générer : openssl rand -hex 16
# RATE_LIMIT_SALT=""
