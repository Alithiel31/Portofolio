generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int      @id @default(autoincrement())
  name        String
  titleEn     String
  titleFr     String?
  bioEn       String   @db.Text
  bioFr       String?  @db.Text
  photoUrl    String?
  email       String?
  location    String?
  cvEn        String?
  cvFr        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  socialLinks SocialLink[]
}

model SocialLink {
  id        Int     @id @default(autoincrement())
  platform  String
  url       String
  icon      String
  order     Int     @default(0)
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Experience {
  id             Int            @id @default(autoincrement())
  year           String
  titleEn        String
  titleFr        String?
  company        String
  descriptionEn  String         @db.Text
  descriptionFr  String?        @db.Text
  type           ExperienceType @default(WORK)
  order          Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum ExperienceType {
  WORK
  EDUCATION
}

model SkillCategory {
  id     Int     @id @default(autoincrement())
  name   String
  nameFr String?
  icon   String?
  order  Int     @default(0)
  skills Skill[]
}

model Skill {
  id         Int           @id @default(autoincrement())
  name       String
  type       SkillType     @default(MAIN)
  parent     String?
  iconUrl    String?
  order      Int           @default(0)
  categoryId Int
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

enum SkillType {
  MAIN
  FRAMEWORK
  LEARNING
}

model Project {
  id            Int           @id @default(autoincrement())
  titleEn       String
  titleFr       String?
  descriptionEn String        @db.Text
  descriptionFr String?       @db.Text
  techStack     String
  imageUrl      String?
  demoUrl       String?
  githubUrl     String?
  featured      Boolean       @default(false)
  status        ProjectStatus @default(COMPLETED)
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
}

model Service {
  id            Int      @id @default(autoincrement())
  titleEn       String
  titleFr       String?
  descriptionEn String   @db.Text
  descriptionFr String?  @db.Text
  icon          String
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PageView {
  id        Int      @id @default(autoincrement())
  page      String
  country   String?
  region    String?
  city      String?
  zone      String?  // "Canada", "Europe", "Autre"
  referer   String?
  createdAt DateTime @default(now())
}
